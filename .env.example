# DeepSeek API Key（必填）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 硅基流动 API Key（Embedding 用，免费额度够日常使用）
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Brain 配置
BRAIN_LLM__PROVIDER=deepseek
BRAIN_LLM__MODEL=deepseek-chat
BRAIN_EMBEDDING__PROVIDER=siliconflow
BRAIN_DRY_RUN=false
BRAIN_LOG_LEVEL=INFO

# PostgreSQL 数据库配置（业务数据 + 向量 + Checkpoint 统一存储）
BRAIN_DB_HOST=localhost
BRAIN_DB_PORT=5432
BRAIN_DB_USER=postgres
BRAIN_DB_PASSWORD=your_password
BRAIN_DB_DATABASE=brain
